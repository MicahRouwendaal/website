# Public domain used by Caddy
DOMAIN=maison-olive.example.com

# API auth and crypto
TOKEN_SECRET=change-this-with-a-long-random-secret
AUTH_REQUIRED=true
TOKEN_TTL_HOURS=12
WEB_CONCURRENCY=2

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$210000$replace_salt_hex$replace_hash_hex
# Optional local bootstrap only (remove in real production)
ADMIN_PASSWORD=change-me
MIN_STAFF_PASSWORD_LENGTH=10

# API abuse protection
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_SEC=900
BOOKING_RATE_LIMIT=40
BOOKING_RATE_WINDOW_SEC=600

# SQLAlchemy pool tuning (for non-SQLite profiles)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Database profile: Local PostgreSQL (Free, self-hosted)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Ikbendiamic12
DATABASE_URL=postgresql://postgres:[Ikbendiamic12]@db.tlpazdwgbtwhclvrqbdx.supabase.co:5432/postgres

# Site file name generated by this exporter
SITE_FILE=generated-site.html
